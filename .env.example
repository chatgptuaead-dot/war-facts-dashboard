# ── Conflict event data (pick one) ──────────────────────────────────────────
# GDELT: built-in, no key needed (media-derived event counts, updates every 15min)
# ACLED: upgrade path — verified events + fatalities (requires registration)
ACLED_EMAIL=your@email.com
ACLED_KEY=your-acled-api-key

# ── Fatality data ────────────────────────────────────────────────────────────
# UCDP: verified fatality counts — email mertcan.yilmaz@pcr.uu.se to request token
# Subject: "API token request for conflict monitoring dashboard"
UCDP_TOKEN=your-ucdp-token

# ── Supplemental news ────────────────────────────────────────────────────────
# NewsAPI — https://newsapi.org/ (free tier: 100 req/day, instant signup)
NEWSAPI_KEY=your-newsapi-key

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3457
